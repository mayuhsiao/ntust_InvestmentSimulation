rules_version = '2';

// ==================================================================
// emrd 專案 Firestore 安全性規則（合併版）
//
//   messages/     → emrd-web 公告板（原有規則，原封不動保留）
//   config/       ↘
//   students/      ｜
//   trades/        ｜ 台股投資模擬競賽
//   prices/        ｜
//   settlements/  ↗
//
// 部署方式（擇一）：
//   A. Firebase 主控台 → Firestore → (default) → 規則 → 貼上後「發布」
//   B. npx firebase-tools deploy --only firestore:rules
//
// ⚠️ 下面 adminIds() 是老師（管理者）名單，要與 .env 的
//    VITE_ADMIN_IDS 一致，否則管理頁面會出現「權限不足」。
// ==================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    /* ================================================================
     * 一、emrd-web 公告板
     * ----------------------------------------------------------------
     * 這段是既有規則，未做任何修改。
     * 該應用程式沒有使用 Firebase Auth，所以維持免登入存取。
     * ================================================================ */

    match /messages/{msg} {
      allow read: if true;
      allow create: if
        request.resource.data.keys().hasOnly(['name', 'text', 'pass', 'ts', 'img', 'cat', 'parent']) &&
        request.resource.data.name is string &&
        request.resource.data.name.size() >= 1 &&
        request.resource.data.name.size() <= 20 &&
        request.resource.data.text is string &&
        request.resource.data.text.size() <= 500 &&
        request.resource.data.pass == 'EMRD115' &&
        request.resource.data.ts == request.time &&
        (
          (
            !('parent' in request.resource.data) &&
            'cat' in request.resource.data &&
            request.resource.data.cat in ['公告', '學生事務', '課業/課表', '考試', '活動揪團', '閒聊'] &&
            (request.resource.data.text.size() >= 1 || 'img' in request.resource.data) &&
            (!('img' in request.resource.data) ||
              (request.resource.data.img is string &&
               request.resource.data.img.size() < 500 &&
               request.resource.data.img.matches('https://res\\.cloudinary\\.com/wollurnv/.*')))
          )
          ||
          (
            'parent' in request.resource.data &&
            request.resource.data.parent is string &&
            request.resource.data.parent.size() >= 1 &&
            request.resource.data.parent.size() <= 40 &&
            !('cat' in request.resource.data) &&
            !('img' in request.resource.data) &&
            request.resource.data.text.size() >= 1
          )
        );
      allow update, delete: if false;
    }

    /* ================================================================
     * 二、台股投資模擬競賽
     * ================================================================ */

    // ---------- 共用函式 ----------

    function signedIn() {
      return request.auth != null && request.auth.token.email != null;
    }

    // 由登入信箱推回學號：m11426913@ntust-invest.local → M11426913
    function myId() {
      return request.auth.token.email.split('@')[0].upper();
    }

    // 👇👇 老師（管理者）的學號，可多筆 👇👇
    function adminIds() {
      return ['TEACHER'];
    }

    function isAdmin() {
      return signedIn() && (
        myId() in adminIds() ||
        (
          exists(/databases/$(database)/documents/students/$(myId())) &&
          get(/databases/$(database)/documents/students/$(myId())).data.role == 'admin'
        )
      );
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // 任何人都能用 API 金鑰自行註冊 Firebase 帳號，
    // 所以「有登入」不等於「是這門課的學生」，寫入時要再確認在名單中。
    function inRoster() {
      return signedIn() && exists(/databases/$(database)/documents/students/$(myId()));
    }

    // ---------- 競賽設定 ----------
    // 所有登入者可讀，只有老師能改
    match /config/{docId} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- 學生名單 ----------
    match /students/{studentId} {
      // 排行榜需要看到全班姓名與組別
      allow read: if signedIn();

      // 老師可以新增／修改／刪除任何人
      allow write: if isAdmin();

      // 老師本人第一次啟用帳號時，允許建立自己的資料
      allow create: if signedIn()
                    && studentId == myId()
                    && myId() in adminIds();

      // 學生「首次啟用帳號」：只能認領自己的學號，且只能寫這幾個欄位
      allow update: if signedIn()
                    && studentId == myId()
                    && changedKeys().hasOnly(['uid', 'activated', 'activatedAt', 'name', 'group', 'role'])
                    && request.resource.data.uid == request.auth.uid
                    && request.resource.data.role == resource.data.get('role', 'student');
    }

    // ---------- 交易紀錄 ----------
    match /trades/{tradeId} {
      // 全班可讀（排行榜與持股比較需要）
      allow read: if signedIn();

      // 只能用自己的學號下單，而且必須在老師匯入的名單中；老師可代任何學生下單
      allow create: if signedIn()
                    && (isAdmin() || (request.resource.data.studentId == myId() && inRoster()))
                    && request.resource.data.shares is number
                    && request.resource.data.shares > 0
                    && request.resource.data.price is number
                    && request.resource.data.price > 0
                    && request.resource.data.side in ['BUY', 'SELL'];

      // 成交後 30 分鐘內可自行撤銷（打錯股數的補救），老師不受限
      allow delete: if isAdmin() || (
                      signedIn() &&
                      resource.data.studentId == myId() &&
                      request.time < resource.data.createdAt + duration.value(30, 'm')
                    );

      // 交易紀錄不可竄改
      allow update: if isAdmin();
    }

    // ---------- 收盤價快取 ----------
    // ⚠️ 只有老師能寫入。
    // 這份快取是全班共用的，淨值與排名都以它計價；
    // 若開放學生寫入，任何人都能竄改自己持股的收盤價來灌水報酬率。
    // 學生端讀不到快取時會直接向 /api 取得即時報價，功能不受影響。
    match /prices/{code} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // ---------- 每日結算 ----------
    match /settlements/{date} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    /* ================================================================
     * 三、其他一律拒絕
     * ================================================================ */

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
